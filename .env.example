DATABASE_URL="file:./dev.db"

# Chave da API da Claude (https://console.anthropic.com/) — necessária para gerar as
# copies de redes sociais, e-mail marketing e notícia a partir do conteúdo já gerado.
ANTHROPIC_API_KEY=""

# Modelo usado para gerar as copies. Padrão: claude-opus-5.
ANTHROPIC_MODEL=""

# Chave da API-Football (https://www.api-football.com/) — obrigatória para sincronizar
# partidas e gerar conteúdo. Sem ela o app roda normalmente mas nada é sincronizado.
API_FOOTBALL_KEY=""

# true se a chave for do plano contratado via RapidAPI em vez do host direto api-sports.io
API_FOOTBALL_USE_RAPIDAPI="false"

# Quantas horas antes do apito inicial o conteúdo de pré-jogo deve ser gerado.
PRE_LEAD_HOURS="6"

# Temporada a sincronizar (ex: "2026"). Planos free da API-Football só liberam
# temporadas antigas — se sua chave não tiver acesso à temporada atual, defina
# aqui um ano permitido no seu plano (a mensagem de erro no terminal informa quais).
# Sem essa variável, usa o ano corrente automaticamente.
SYNC_SEASON=""

# Intervalo (minutos) do worker: sincronização geral do calendário.
SYNC_INTERVAL_MINUTES="60"

# Intervalo (minutos) do worker: checagem de partidas ao vivo / intervalo / encerradas.
LIVE_POLL_INTERVAL_MINUTES="2"
