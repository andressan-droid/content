// Schema do banco de dados do FutebolCard Auto Content
// Modelos: clubes clientes, partidas (fixtures) e os 3 conteúdos gerados por partida.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Clube cliente da FutebolCard
model Club {
  id             String    @id @default(cuid())
  name           String    @unique
  shortName      String
  slug           String    @unique
  apiSearch      String?   // termo usado para buscar o time na API-Football (pode diferir do nome de exibição)
  apiFootballId  Int?      @unique
  country        String    @default("Brazil")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fixtures       Fixture[]

  @@index([active])
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  POSTPONED
  CANCELLED
}

// Uma partida de um clube cliente (o clube pode ser mandante ou visitante)
model Fixture {
  id               String        @id @default(cuid())
  club             Club          @relation(fields: [clubId], references: [id])
  clubId           String

  apiFootballId    Int           @unique

  leagueName       String
  leagueApiId      Int
  season           Int
  round            String?

  homeTeamName     String
  homeTeamApiId    Int
  homeTeamLogo     String?
  awayTeamName     String
  awayTeamApiId    Int
  awayTeamLogo     String?

  homeGoals        Int?
  awayGoals        Int?
  homeGoalsHT      Int?
  awayGoalsHT      Int?

  venueName        String?
  venueCity        String?
  kickoff          DateTime
  status           FixtureStatus @default(SCHEDULED)
  statusShort      String?

  rawStatsJson     String?       // cache do último payload de estatísticas/eventos da API-Football
  rawPredictionJson String?      // cache do payload de predictions/odds

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contents         Content[]

  @@index([clubId, kickoff])
  @@index([status])
}

enum ContentStage {
  PRE
  HALFTIME
  POST
}

enum ContentStatus {
  PENDING
  GENERATED
  FAILED
  PUBLISHED
}

// Conteúdo gerado para uma partida (pré-jogo, intervalo, pós-jogo)
model Content {
  id          String        @id @default(cuid())
  fixture     Fixture       @relation(fields: [fixtureId], references: [id])
  fixtureId   String

  stage       ContentStage
  status      ContentStatus @default(PENDING)

  title       String?
  body        String?       // texto final do conteúdo (markdown simples)
  dataJson    String?       // dados estruturados usados para montar o conteúdo (auditoria/reuso)
  error       String?

  generatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  copies      Copy[]

  @@unique([fixtureId, stage])
}

enum CopyChannel {
  SOCIAL // redes sociais (post curto, com emojis/hashtags)
  EMAIL  // e-mail marketing (assunto + corpo, com CTA)
  NEWS   // notícia para portal (texto jornalístico)
  TWEET  // post para X/Twitter (até 280 caracteres)
  REELS  // roteiro falado para gravação de Reels/TikTok/Shorts
}

// Copy gerada por IA (Claude) para um canal específico, a partir do Content base
// (que já traz os dados reais da partida vindos da API-Football).
model Copy {
  id          String        @id @default(cuid())
  content     Content       @relation(fields: [contentId], references: [id])
  contentId   String

  channel     CopyChannel
  status      ContentStatus @default(PENDING)

  subject     String?       // usado só no canal EMAIL
  body        String?
  error       String?

  generatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([contentId, channel])
}
